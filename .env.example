# CRM base URL. Optional — defaults to https://crm.incumbency.ai when unset.
# Set it only to point at a different CRM (e.g. staging).
CRM_BASE_URL=https://crm.incumbency.ai

# Shared secret for the CRM lead webhook (HMAC-SHA256 signing key).
# SERVER ONLY — must never reach the browser or be committed. Anyone holding it
# can create people in the CRM. Get it from the CRM admin; it must match the
# CRM's own LEADS_WEBHOOK_SECRET.
LEADS_WEBHOOK_SECRET=change-me

# Google Analytics Measurement Protocol — GA Admin → Data streams → (your web
# stream) → Measurement Protocol API secrets. Records successful submissions.
# Optional: without it no conversion is recorded.
GA_API_SECRET=xxxxxxxxxxxxxxxxxxxxxx
