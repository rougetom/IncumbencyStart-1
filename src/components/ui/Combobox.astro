---
// Searchable combobox backed by the CRM MP list (/api/principals). Submits the
// selected principal's id via a hidden input named `name`. Requires JS, like
// the rest of the form.
type Props = {
  label: string;
  name: string;
  id?: string;
  endpoint?: string;
  placeholder?: string;
};

const {
  label,
  name,
  id = `combobox-${name}`,
  endpoint = '/api/principals',
  placeholder = 'Search by name',
} = Astro.props;

const errorId = `${id}-error`;
const listId = `${id}-list`;
const stateId = `${id}-state`;
---

<div class="field combobox" data-combobox data-endpoint={endpoint}>
  <label class="field__label" id={`${id}-label`} for={`${id}-input`}>{label}</label>
  <div class="combobox__control">
    <svg class="combobox__search" viewBox="0 0 20 20" fill="none" aria-hidden="true" data-combobox-search>
      <circle cx="9" cy="9" r="6" stroke="currentColor" stroke-width="1.8" />
      <line x1="13.5" y1="13.5" x2="17.5" y2="17.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
    </svg>
    <input
      class="field__input combobox__input"
      id={`${id}-input`}
      type="text"
      role="combobox"
      aria-expanded="false"
      aria-autocomplete="list"
      aria-controls={listId}
      aria-labelledby={`${id}-label`}
      aria-describedby={errorId}
      autocomplete="off"
      autocapitalize="none"
      spellcheck="false"
      placeholder={placeholder}
      data-combobox-input
    />
    <ul class="combobox__list" id={listId} role="listbox" aria-labelledby={`${id}-label`} data-combobox-list hidden></ul>
  </div>
  <input type="hidden" name={name} id={`${id}-value`} data-combobox-value />
  <p class="combobox__state" id={stateId} role="status" aria-live="polite" data-combobox-state hidden></p>
  <p class="field__error" id={errorId} hidden></p>
</div>


<script>
  import type { Principal } from '../../lib/leads';

  const MAX_OPTIONS = 50;

  function haystack(p: Principal) {
    return `${p.name} ${p.constituency ?? ''}`.toLowerCase();
  }

  function setupCombobox(root: HTMLElement) {
    const endpoint = root.dataset.endpoint || '/api/principals';
    // Assert non-null (checked at runtime just below) so the nested closures
    // see non-null types — TS doesn't carry a guard's narrowing into them.
    const control = root.querySelector<HTMLDivElement>('.combobox__control')!;
    const input = root.querySelector<HTMLInputElement>('[data-combobox-input]')!;
    const list = root.querySelector<HTMLUListElement>('[data-combobox-list]')!;
    const value = root.querySelector<HTMLInputElement>('[data-combobox-value]')!;
    const state = root.querySelector<HTMLParagraphElement>('[data-combobox-state]')!;
    const error = root.querySelector<HTMLParagraphElement>('.field__error');
    if (!control || !input || !list || !value || !state) return;

    let all: Principal[] = [];
    let shown: Principal[] = [];
    let active = -1;
    let loaded = false;
    let selectedLabel: string | null = null;

    // When the box still shows a committed selection, reopening lists everything
    // rather than filtering by that label; once the visitor types, their text
    // filters as usual.
    function openQuery() {
      return input.value === selectedLabel ? '' : input.value;
    }

    function showState(message: string, isError: boolean, withRetry = false) {
      state.textContent = message;
      state.classList.toggle('is-error', isError);
      state.hidden = false;
      if (withRetry) {
        const retry = document.createElement('button');
        retry.type = 'button';
        retry.className = 'combobox__retry';
        retry.textContent = 'Retry';
        retry.addEventListener('click', () => load());
        state.append(' ', retry);
      }
    }

    function clearState() {
      state.textContent = '';
      state.hidden = true;
      state.classList.remove('is-error');
    }

    function clearError() {
      if (!error) return;
      error.textContent = '';
      error.hidden = true;
      root.classList.remove('field--error');
      input.removeAttribute('aria-invalid');
    }

    function close() {
      list.hidden = true;
      input.setAttribute('aria-expanded', 'false');
      control.classList.remove('is-open');
      active = -1;
    }

    function render(query: string) {
      const q = query.trim().toLowerCase();
      shown = (q ? all.filter((p) => haystack(p).includes(q)) : all).slice(0, MAX_OPTIONS);
      list.innerHTML = '';
      if (!loaded) return;

      if (shown.length === 0) {
        const li = document.createElement('li');
        li.className = 'combobox__empty';
        li.textContent = 'No matching MP.';
        list.append(li);
      } else {
        shown.forEach((p, i) => {
          const li = document.createElement('li');
          li.className = 'combobox__option';
          li.id = `${input.id}-opt-${i}`;
          li.setAttribute('role', 'option');
          li.setAttribute('aria-selected', 'false');
          li.dataset.id = p.id;
          if (p.id === value.value) li.classList.add('is-chosen');

          const content = document.createElement('span');
          content.className = 'combobox__text';
          const name = document.createElement('span');
          name.className = 'combobox__name';
          name.textContent = p.name;
          content.append(name);
          if (p.constituency) {
            const meta = document.createElement('span');
            meta.className = 'combobox__meta';
            meta.textContent = p.constituency;
            content.append(meta);
          }

          const check = document.createElement('span');
          check.className = 'combobox__check';
          check.setAttribute('aria-hidden', 'true');
          check.textContent = '✓';

          li.append(content, check);
          li.addEventListener('mousedown', (e) => {
            e.preventDefault();
            select(i);
          });
          list.append(li);
        });
      }
      list.hidden = false;
      input.setAttribute('aria-expanded', 'true');
      control.classList.add('is-open');
    }

    function highlight(next: number) {
      const options = Array.from(list.querySelectorAll<HTMLLIElement>('.combobox__option'));
      if (options.length === 0) return;
      active = (next + options.length) % options.length;
      options.forEach((el, i) => el.setAttribute('aria-selected', i === active ? 'true' : 'false'));
      const el = options[active];
      input.setAttribute('aria-activedescendant', el.id);
      el.scrollIntoView({ block: 'nearest' });
    }

    function select(index: number) {
      const p = shown[index];
      if (!p) return;
      // The box shows only the MP's name once chosen; the dropdown still shows
      // name + constituency.
      input.value = p.name;
      selectedLabel = p.name;
      value.value = p.id;
      clearError();
      close();
      input.removeAttribute('aria-activedescendant');
    }

    async function load() {
      clearState();
      showState('Loading MPs…', false);
      try {
        const res = await fetch(endpoint, { headers: { Accept: 'application/json' } });
        if (!res.ok) throw new Error(`HTTP ${res.status}`);
        const data = (await res.json()) as Principal[];
        all = Array.isArray(data) ? data : [];
        loaded = true;
        clearState();
        if (document.activeElement === input) render(input.value);
      } catch {
        loaded = false;
        showState("Couldn't load the MP list.", true, true);
      }
    }

    input.addEventListener('focus', () => {
      if (loaded) render(openQuery());
    });

    input.addEventListener('click', () => {
      if (loaded && list.hidden) render(openQuery());
    });

    input.addEventListener('input', () => {
      // Editing invalidates any previous selection until one is picked again.
      selectedLabel = null;
      value.value = '';
      clearError();
      if (loaded) render(input.value);
    });

    input.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowDown') {
        event.preventDefault();
        if (list.hidden) render(openQuery());
        highlight(active + 1);
      } else if (event.key === 'ArrowUp') {
        event.preventDefault();
        if (list.hidden) render(openQuery());
        highlight(active - 1);
      } else if (event.key === 'Enter') {
        if (!list.hidden && active >= 0) {
          event.preventDefault();
          select(active);
        }
      } else if (event.key === 'Escape') {
        close();
      }
    });

    input.addEventListener('blur', () => {
      // Let a click on an option register first (it uses mousedown + preventDefault).
      window.setTimeout(close, 120);
    });

    load();
  }

  document.querySelectorAll<HTMLElement>('[data-combobox]').forEach(setupCombobox);
</script>
