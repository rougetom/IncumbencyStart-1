---
import type { HTMLAttributes } from 'astro/types';

type Props = {
  label: string;
  name: string;
  id?: string;
  error?: string;
} & HTMLAttributes<'input'>;

const { label, name, id = `field-${name}`, error, type = 'text', ...rest } = Astro.props;
const errorId = `${id}-error`;
---

<div class:list={['field', error && 'field--error']}>
  <label class="field__label" for={id}>{label}</label>
  <input
    class="field__input"
    id={id}
    name={name}
    type={type}
    aria-invalid={error ? 'true' : undefined}
    aria-describedby={error ? errorId : undefined}
    {...rest}
  />
  <p class="field__error" id={errorId} hidden={!error}>{error}</p>
</div>
