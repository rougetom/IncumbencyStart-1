---
import mintLogo from '../../assets/logo-mint.svg?raw';
import whiteLogo from '../../assets/logo-white.svg?raw';

interface Props {
  href?: string;
  size?: 'md' | 'lg';
  /** 'mint' = primary logo for solid dark areas; 'white' = over photography/busy backgrounds. */
  variant?: 'mint' | 'white';
}

const { href = '/', size = 'md', variant = 'mint' } = Astro.props;
const svg = variant === 'white' ? whiteLogo : mintLogo;
---

<a class:list={['logo', `logo--${size}`]} href={href} aria-label="Incumbency.AI home">
  <Fragment set:html={svg} />
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    line-height: 0;
  }

  .logo :global(svg) {
    height: 1.75rem;
    width: auto;
    display: block;
  }

  .logo--lg :global(svg) {
    height: 2.5rem;
  }
</style>
