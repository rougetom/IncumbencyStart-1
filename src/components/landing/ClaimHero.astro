---
import SiteHeader from './SiteHeader.astro';
import ClaimForm from './ClaimForm.astro';
import Eyebrow from '../ui/Eyebrow.astro';
import Heading from '../ui/Heading.astro';
import AccreditationTags from '../ui/AccreditationTags.astro';
import Card from '../ui/Card.astro';
---

<section class="hero">
  <SiteHeader />
  <div class="wrap hero__grid">
    <div class="hero__copy">
      <div class="hero__photo anim-rise" style="--i: 0">
        <img
          src="/images/hero-westminster-1536.webp"
          srcset="/images/hero-westminster-800.webp 800w, /images/hero-westminster-1536.webp 1536w"
          sizes="(max-width: 960px) 100vw, 50vw"
          width="1536"
          height="1024"
          alt="Two people wearing black backpacks walk across Westminster Bridge towards the Houses of Parliament at sunset."
          fetchpriority="high"
          decoding="async"
        />
        <div class="hero__photo-badge"><Eyebrow variant="badge">Claim your bag</Eyebrow></div>
      </div>
      <Heading level={1} class="anim-rise" style="--i: 1">Let's make <strong>democratic data more secure.</strong></Heading>
      <p class="hero__lead anim-rise" style="--i: 2">
        We are giving away anti-theft laptop bags to Parliamentary staffers to protect physical data security. Claim
        yours today.
      </p>
      <div class="hero__tags anim-rise" style="--i: 3"><AccreditationTags /></div>
    </div>

    <div class="hero__form" id="claim">
      <Card class="anim-focus" style="--i: 3">
        <h2 class="visually-hidden">Claim your anti-theft laptop bag</h2>
        <ClaimForm />
      </Card>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    overflow: clip;
    padding-bottom: clamp(4rem, 3rem + 4vw, 8rem);
    border-bottom: 1px solid var(--color-border);
    background: var(--color-bg);
  }

  /* Bokeh layer, drifts slower than the page for a gentle parallax. */
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(to bottom, rgba(20, 43, 34, 0) 0, rgba(20, 43, 34, 0.35) 12rem, var(--color-bg) 34rem),
      url('/images/bokeh-bg.webp') center -4vw / max(100%, 1100px) auto no-repeat;
    pointer-events: none;
  }

  @keyframes bokeh-drift {
    to {
      transform: translateY(56px);
    }
  }

  @supports (animation-timeline: scroll()) {
    .hero::before {
      animation: bokeh-drift linear both;
      animation-timeline: scroll(root);
      animation-range: 0 800px;
    }
  }

  .hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    gap: clamp(2.5rem, 1rem + 4vw, 5rem);
    align-items: start;
    padding-top: clamp(1.5rem, 1rem + 2vw, 3.5rem);
  }

  .hero__copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.75rem;
  }

  .hero__photo {
    position: relative;
    width: 100%;
    aspect-ratio: 3 / 2;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-panel);
    overflow: hidden;
  }

  .hero__photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero__photo-badge {
    position: absolute;
    left: clamp(0.75rem, 2vw, 1.25rem);
    bottom: clamp(0.75rem, 2vw, 1.25rem);
  }

  /* Over the photo the badge needs a solid backing to stay readable. */
  .hero__photo-badge :global(.eyebrow--badge) {
    background: rgba(20, 43, 34, 0.72);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
  }

  .hero__lead {
    font-size: var(--text-lead);
    color: var(--color-text-muted);
    max-width: 33rem;
    line-height: 1.65;
  }

  .hero__tags {
    margin-top: 0.5rem;
  }

  .hero__form {
    scroll-margin-top: 2rem;
  }

  @media (max-width: 960px) {
    .hero__grid {
      grid-template-columns: 1fr;
    }

    /* On mobile the tags sit in the about section instead. */
    .hero__tags {
      display: none;
    }
  }
</style>
